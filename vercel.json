{
    "rewrites": [
      { "source": "/", "destination": "/Homepage/index.html" },
      { "source": "/Dashboard", "destination": "/Dashboard/index.html" },
      { "source": "/Homepage", "destination": "/Homepage/index.html" },
      { "source": "/Login", "destination": "/Login/index.html" },
      { "source": "/Budget", "destination": "/Budget/index.html" },
      { "source": "/Transactions", "destination": "/Transactions/index.html" },
      { "source": "/IncomeExpenses", "destination": "/IncomeExpenses/index.html" },
      { "source": "/404", "destination": "/404.html" }
    ],
    "headers": [
      {
        "source": "/:path*.(css|js)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      }
    ]
  }